{
  "name": "mathgame",
  "version": "1.0.0",
  "description": "mathgame - Ultra-Low Latency Mental Math Speedrunning on Cloudflare Workers & Cloudflare D1",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create mathgame",
    "d1:init:local": "wrangler d1 execute mathgame --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute mathgame --remote --file=./schema.sql",
    "test": "node test/local-sim.js"
  },
  "devDependencies": {
    "wrangler": "^4.154.0"
  }
}
