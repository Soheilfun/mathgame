{
  "name": "zehnbarter-math",
  "version": "1.0.0",
  "description": "ZehnBarter (MathArcade IR) - Competitive Mental Math Speedrunning on Cloudflare Workers & D1",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create zehnbarter_db",
    "d1:init:local": "wrangler d1 execute zehnbarter_db --local --file=./schema.sql",
    "d1:init:remote": "wrangler d1 execute zehnbarter_db --remote --file=./schema.sql",
    "test": "node test/local-sim.js"
  },
  "devDependencies": {
    "wrangler": "^4.154.0"
  }
}
